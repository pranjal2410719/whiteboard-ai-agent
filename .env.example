DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Gemini is the primary tutor model. Server-side only; never expose this in client code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Google Cloud Vertex AI & Enterprise Agent Platform settings
USE_VERTEX_AI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
# Optional fallback provider used when no Gemini key is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Set true when serving over HTTPS.
COOKIE_SECURE=false
