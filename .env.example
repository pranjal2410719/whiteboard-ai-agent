DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# 1. AI Tutor API Key (teaches classes, multimodal whiteboard drawing, perception & doubt resolution)
# Can be bound to Google Cloud Agent Platform / Vertex AI or Google AI Studio
GEMINI_API_KEY=
TUTOR_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Voice & Speech API Key (synthesizes Professor's spoken audio; falls back to GEMINI_API_KEY if unset)
VOICE_API_KEY=
TTS_API_KEY=

# Google Cloud Vertex AI & Enterprise Agent Platform settings
USE_VERTEX_AI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1

# 3. Optional fallback provider used when no Gemini key is configured
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Set true when serving over HTTPS
COOKIE_SECURE=false
