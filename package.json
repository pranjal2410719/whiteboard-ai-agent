{
  "name": "chalkly-ai-whiteboard-tutor",
  "version": "1.0.0",
  "description": "Interactive AI Whiteboard Tutor Platform with Gemini 3.8 Live API, real-time voice, and multimodal whiteboard",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && wrangler dev",
    "deploy:cloudflare": "opennextjs-cloudflare build && wrangler deploy",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:webrtc": "playwright test tests/webrtc-boost.spec.ts tests/duplex-voice.spec.ts",
    "test:classes": "playwright test tests/modular-classes-runtime.spec.ts",
    "test:regression": "playwright test tests/studio.spec.ts tests/static-thumbnail-and-class-prep.spec.ts tests/visual-cell-sync.spec.ts tests/visual-heart-sync.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.23",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "wrangler": "^4.167.0"
  }
}
